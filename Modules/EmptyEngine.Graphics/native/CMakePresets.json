{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-x64",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/../../../.artifacts/basisu-build/windows-x64",
      "architecture": "x64"
    },
    {
      "name": "windows-arm64",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/../../../.artifacts/basisu-build/windows-arm64",
      "architecture": "ARM64"
    },
    {
      "name": "apple-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "macos-arm64",
      "inherits": "apple-base",
      "binaryDir": "${sourceDir}/../../../.artifacts/basisu-build/macos-arm64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      }
    },
    {
      "name": "macos-x64",
      "inherits": "apple-base",
      "binaryDir": "${sourceDir}/../../../.artifacts/basisu-build/macos-x64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      }
    },
    {
      "name": "ios-arm64",
      "description": "The WebGpu preset of the same name uses the Xcode generator because of Dawn, but this one builds only two of our own sources, so Ninja is enough (single-config: no configuration name in the output path, and no Placeholder.o cleanup needed).",
      "inherits": "apple-base",
      "binaryDir": "${sourceDir}/../../../.artifacts/basisu-build/ios-arm64",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64-release", "configurePreset": "windows-x64", "configuration": "Release", "targets": ["basisu_transcoder"], "jobs": 0 },
    { "name": "windows-arm64-release", "configurePreset": "windows-arm64", "configuration": "Release", "targets": ["basisu_transcoder"], "jobs": 0 },
    { "name": "macos-arm64-release", "configurePreset": "macos-arm64", "targets": ["basisu_transcoder"], "jobs": 0 },
    { "name": "macos-x64-release", "configurePreset": "macos-x64", "targets": ["basisu_transcoder"], "jobs": 0 },
    { "name": "ios-arm64-release", "configurePreset": "ios-arm64", "targets": ["basisu_transcoder"], "jobs": 0 }
  ]
}
