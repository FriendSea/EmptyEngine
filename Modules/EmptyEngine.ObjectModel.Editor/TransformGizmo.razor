@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="gizmo">
    <svg viewBox="0 0 @S @S" width="@S" height="@S" @ref="_svg">
        <rect x="0" y="0" width="@S" height="@S" fill="#25282E" />

        @foreach ((GizmoAxis axis, string ring, string knob) in Rings)
        {
            GizmoPoint kp = Model.KnobPoint(axis);
            <polyline points="@Points(Model.RingPolyline(axis))" fill="none" stroke="@ring" stroke-width="1.5" />
            <circle cx="@N(kp.X)" cy="@N(kp.Y)" r="@N(KnobRadius)" fill="@knob"
                    data-gizmo-x="@N(kp.X)" data-gizmo-y="@N(kp.Y)" data-gizmo-radius="@TransformGizmoModel.HitRadius" />
        }

        @foreach ((GizmoAxis axis, string color) in Axes)
        {
            GizmoPoint tip = Model.AxisTip(axis);
            <line x1="@N(Cx)" y1="@N(Cy)" x2="@N(tip.X)" y2="@N(tip.Y)" stroke="@color" stroke-width="2.5" />
            <rect x="@N(tip.X - 4)" y="@N(tip.Y - 4)" width="8" height="8" fill="@color"
                  data-gizmo-x="@N(tip.X)" data-gizmo-y="@N(tip.Y)" data-gizmo-radius="@TransformGizmoModel.HitRadius" />
            @(Label(tip.X + 4, tip.Y - 6, axis.ToString()))
        }

        <circle cx="@N(Cx)" cy="@N(Cy)" r="5" fill="#F5F5F5"
                data-gizmo-x="@N(Cx)" data-gizmo-y="@N(Cy)" data-gizmo-radius="@TransformGizmoModel.CenterHitRadius" />
        @(Label(8, S - 8, RotationLabel))
    </svg>
</div>

@code {
    [Parameter, EditorRequired] public TransformGizmoModel Model { get; set; } = null!;

    private ElementReference _svg;
    private IJSObjectReference? _module;
    private IJSObjectReference? _drag;
    private DotNetObjectReference<TransformGizmo>? _self;
    private bool _disposed;

    private const double S = TransformGizmoModel.Surface;
    private const double Cx = S / 2;
    private const double Cy = S / 2;
    private const double KnobRadius = TransformGizmoModel.HitRadius * 0.7;

    private static readonly (GizmoAxis Axis, string Ring, string Knob)[] Rings =
    [
        (GizmoAxis.X, "#D0555559", "#D05555"),
        (GizmoAxis.Y, "#5AB05A59", "#5AB05A"),
        (GizmoAxis.Z, "#5A7AD859", "#5A7AD8"),
    ];

    private static readonly (GizmoAxis Axis, string Color)[] Axes =
    [
        (GizmoAxis.X, "#D05555"),
        (GizmoAxis.Y, "#5AB05A"),
        (GizmoAxis.Z, "#5A7AD8"),
    ];

    private string RotationLabel =>
        $"X {Model.RotationDeg.X:0.#}°  Y {Model.RotationDeg.Y:0.#}°  Z {Model.RotationDeg.Z:0.#}°";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "/_content/EmptyEngine.Editor/editor.js");
        if (_disposed)
        {
            await module.DisposeAsync();
            return;
        }
        _module = module;
        _self = DotNetObjectReference.Create(this);
        IJSObjectReference drag = await module.InvokeAsync<IJSObjectReference>("attachGizmo", _svg, _self);
        if (_disposed)
        {
            await drag.InvokeVoidAsync("dispose");
            await drag.DisposeAsync();
            return;
        }
        _drag = drag;
    }

    [JSInvokable]
    public bool BeginDrag(double x, double y) => !_disposed && Model.BeginDrag(x, y);

    [JSInvokable]
    public void DragTo(double x, double y)
    {
        if (_disposed || !Model.IsDragging) return;
        Model.DragTo(x, y);
        StateHasChanged();
    }

    [JSInvokable]
    public void EndDrag() => Model.EndDrag();

    private static string Points(IReadOnlyList<GizmoPoint> points) =>
        string.Join(' ', points.Select(p => $"{N(p.X)},{N(p.Y)}"));

    private static MarkupString Label(double x, double y, string content) =>
        new($"<text x=\"{N(x)}\" y=\"{N(y)}\" fill=\"#C8CCD2\" font-size=\"11\">"
            + System.Net.WebUtility.HtmlEncode(content)
            + "</text>");

    private static string N(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Model.EndDrag();
        try
        {
            if (_drag is not null)
            {
                await _drag.InvokeVoidAsync("dispose");
                await _drag.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { /* 接続が先に切れた（リビルド時の通常運転） */ }
        finally
        {
            _self?.Dispose();
        }
    }
}
