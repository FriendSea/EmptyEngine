<Project Sdk="Microsoft.NET.Sdk.Razor">

  <ItemGroup>
    <ProjectReference Include="..\..\Core\EmptyEngine.Core\EmptyEngine.Core.csproj" />
    <ProjectReference Include="..\..\Core\EmptyEngine.Editor\EmptyEngine.Editor.csproj" />
    <ProjectReference Include="..\EmptyEngine.WebGpu\EmptyEngine.WebGpu.csproj" />
    <ProjectReference Include="..\EmptyEngine.Graphics\EmptyEngine.Graphics.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EmptyEngine.WebGpu.Tests" />
  </ItemGroup>

  <!-- 同梱する既定シェーダ。パッケージへは .meta ごと梱包し、プロジェクト参照のエディタへはターゲットで場所を返す。 -->
  <Import Project="buildTransitive\EmptyEngine.WebGpu.Editor.props" />

  <ItemGroup>
    <None Remove="assets\**\*;buildTransitive\**\*" />
    <None Include="assets\**\*" Pack="true" PackagePath="assets\%(RecursiveDir)" />
    <None Include="buildTransitive\EmptyEngine.WebGpu.Editor.props" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <Target Name="EmptyEngineGetAssetRoots" Returns="@(EmptyEngineAssetRoot->'%(FullPath)')" />
  <Target Name="EmptyEngineGetDistributionRoots" Returns="@(DistributionRoot)" />

</Project>
