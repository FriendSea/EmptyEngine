@attribute [InspectorFor(ShaderParamsHostTypeId)]
@inherits AuthoringInspectorBase
@inject AssetCatalog Catalog

@foreach (FieldViewModel field in PlainFields(Authoring))
{
    <FieldEditor @key="field" Field="field" />
}

@if (_parameters.Length > 0)
{
    <div class="inspector-section">Parameters</div>
    @foreach (FieldViewModel field in _parameters)
    {
        <FieldEditor @key="field" Field="field" />
    }
}

@code {
    /// <summary>このインスペクタが受け持つコンポーネントの目印</summary>
    internal const string ShaderParamsHostTypeId = "EmptyEngine.WebGpu.IShaderParamsHost";

    private const string MeshComponentTypeId = "EmptyEngine.WebGpu.MeshComponent";
    private const string SpriteComponentTypeId = "EmptyEngine.WebGpu.SpriteComponent";
    private const string LineRendererComponentTypeId = "EmptyEngine.WebGpu.LineRendererComponent";
    private const string EffectComponentTypeId = "EmptyEngine.WebGpu.EffectComponent";
    private const string MaterialAssetTypeId = "EmptyEngine.WebGpu.MaterialAsset";

    private const string MaterialField = "Material";
    private const string VertexParamsField = "VertexParams";

    private FieldViewModel[] _parameters = [];

    protected override void OnAuthoringBound()
    {
        ObserveCollection(Authoring.Fields);
        Rebuild();
    }

    // シェーダ変更で欄の数や型も変わるため、欄を組み直す。
    protected override void OnAuthoringRefreshed() => Rebuild();

    private void Rebuild() =>
        _parameters = BuildParams(Authoring, reference => Catalog.GetAsset(reference.Value));

    /// <summary>シェーダ由来ではない、そのまま並べる編集欄</summary>
    internal static IEnumerable<FieldViewModel> PlainFields(AuthoringObjectViewModel component) =>
        component.Fields.Snapshot.Where(field => field.Name is not ShaderFieldEditors.ParamsField);

    /// <summary>その時点の頂点シェーダが宣言するパラメータの編集欄</summary>
    /// <remarks>
    /// 頂点シェーダは実行時と同じ順で決める：コンポーネントの <c>Shader</c>、マテリアルのシェーダ（頂点を持てば）、同梱の既定。
    /// 編集対象が差し替わった後も <paramref name="component"/> の現在の値へ書き込む。
    /// </remarks>
    internal static FieldViewModel[] BuildParams(
        AuthoringObjectViewModel component,
        Func<AssetKey, AuthoringObject?> tryGetAssetValue)
    {
        AuthoringObject? shader = VertexCapable(ShaderFieldEditors.ResolveShader(
                component.Root.Get(ShaderFieldEditors.ShaderField)?.AssetKey, tryGetAssetValue))
            ?? VertexCapable(MaterialShader(component.Root.Get(MaterialField)?.AssetKey, tryGetAssetValue))
            ?? ShaderFieldEditors.ResolveShader(BuiltinShaderFor(component.TypeName), tryGetAssetValue);

        return ShaderFieldEditors.BuildParams(component, ShaderFieldEditors.ReadParams(shader, VertexParamsField));
    }

    private static AuthoringObject? VertexCapable(AuthoringObject? shader) =>
        shader is not null && ShaderFieldEditors.HasVertex(shader) ? shader : null;

    /// <summary>マテリアルが指すシェーダ（マテリアルが空なら無し）</summary>
    private static AuthoringObject? MaterialShader(string? materialKey, Func<AssetKey, AuthoringObject?> tryGetAssetValue)
    {
        if (string.IsNullOrEmpty(materialKey)) return null;
        if (tryGetAssetValue(new AssetKey(materialKey)) is not { TypeName: MaterialAssetTypeId } material) return null;

        return ShaderFieldEditors.ResolveShader(material.Data.Get(ShaderFieldEditors.ShaderField)?.ReferenceKey, tryGetAssetValue);
    }

    /// <summary>コンポーネント種別ごとの同梱の頂点シェーダ</summary>
    private static string BuiltinShaderFor(string typeName) => typeName switch
    {
        SpriteComponentTypeId => BuiltinShaders.Sprite,
        MeshComponentTypeId => BuiltinShaders.Mesh,
        LineRendererComponentTypeId => BuiltinShaders.Line,
        EffectComponentTypeId => BuiltinShaders.Effect,
        _ => string.Empty,
    };
}
