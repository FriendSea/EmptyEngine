    <EmptyEngineAssetRoot Include="$(MSBuildThisFileDirectory)..\assets" Name="EmptyEngine.WebGpu" />
  </ItemGroup>

  <!-- コンポーネントがキーで引くので、シーンから辿れなくても配布する。 -->
