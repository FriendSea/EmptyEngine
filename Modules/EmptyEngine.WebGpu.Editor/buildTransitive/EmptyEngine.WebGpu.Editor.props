    <DistributionRoot Include="84e640fe39354467b69a0ac4fa6d9e4b" />
    <DistributionRoot Include="7709483a8f3f41f99e7760f4c56f7777" />
    <DistributionRoot Include="796e4bab36074477a12773b3be36a84f" />
  </ItemGroup>

  <!-- 既定マテリアル（Sprite / Mesh / Line / Effect） -->
  <ItemGroup>
