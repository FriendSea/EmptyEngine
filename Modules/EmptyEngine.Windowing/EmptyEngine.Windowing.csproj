<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.4.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="buildTransitive\EmptyEngine.Windowing.targets;native\**\*" />
    <None Include="buildTransitive\EmptyEngine.Windowing.targets"
          Pack="true"
          PackagePath="buildTransitive\EmptyEngine.Windowing.targets" />
    <None Include="native\**\*"
          Pack="true"
          PackagePath="native\" />
  </ItemGroup>

  <!-- desktop のウィンドウと入力の依存関係。 -->
  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input.Glfw" Version="2.23.0" />
    <PackageReference Include="Silk.NET.GLFW" Version="2.23.0" />
  </ItemGroup>

</Project>
