@namespace BevyRuntimeSample.Editor
@using EmptyEngine.Editor.ViewModels.Inspector
@attribute [InspectorFor("bevy_transform::components::transform::Transform")]
@inherits AuthoringInspectorBase

<Vector3Row Label="Position" Model="_position" />
<Vector3Row Label="Rotation" Model="_rotation" />
<Vector3Row Label="Scale" Model="_scale" />

@code {
    private const float PositionSensitivity = 0.01f;
    private const float RotationSensitivity = 0.5f;
    private const float ScaleSensitivity = 0.01f;

    private Vector3FieldGroup _position = null!;
    private Vector3FieldGroup _rotation = null!;
    private Vector3FieldGroup _scale = null!;

    protected override void OnAuthoringBound()
    {
        _position = new Vector3FieldGroup(Authoring, "pos", PositionSensitivity, Apply);
        _rotation = new Vector3FieldGroup(Authoring, "rot", RotationSensitivity, Apply);
        _scale = new Vector3FieldGroup(Authoring, "scale", ScaleSensitivity, Apply);

        Read();
    }

    protected override void OnAuthoringRefreshed() => Read();

    /// <summary>現在の Transform の表示への反映</summary>
    /// <remarks>回転はクォータニオンをオイラー角にして表示する。</remarks>
    private void Read()
    {
        if (Axes("translation", "x", "y", "z") is { } translation)
            _position.Value = Vector(translation);

        if (Axes("scale", "x", "y", "z") is { } scale)
            _scale.Value = Vector(scale);

        if (Axes("rotation", "x", "y", "z", "w") is { } rotation)
        {
            _rotation.Value = QuaternionToEulerDeg(new Quaternion(
                (float)rotation[0].NumericValue, (float)rotation[1].NumericValue,
                (float)rotation[2].NumericValue, (float)rotation[3].NumericValue));
        }
    }

    private void Apply(string editKey)
    {
        if (Axes("translation", "x", "y", "z") is not { } translation
            || Axes("rotation", "x", "y", "z", "w") is not { } rotation
            || Axes("scale", "x", "y", "z") is not { } scale)
        {
            return;
        }

        Quaternion q = EulerDegToQuaternion(_rotation.Value);

        Authoring.Edit(editKey, () =>
        {
            Write(translation, _position.Value);
            Write(scale, _scale.Value);
            rotation[0].NumericValue = q.X;
            rotation[1].NumericValue = q.Y;
            rotation[2].NumericValue = q.Z;
            rotation[3].NumericValue = q.W;
        });
    }

    /// <summary>入れ子 struct の軸の欄。1 つでも引けなければ <c>null</c></summary>
    private FieldViewModel[]? Axes(string group, params string[] axes)
    {
        if (Authoring.Root.Get(group) is not { } map) return null;

        var fields = new FieldViewModel[axes.Length];
        for (int i = 0; i < axes.Length; i++)
        {
            if (map.Get(axes[i]) is not { } axis) return null;
            fields[i] = axis;
        }

        return fields;
    }

    private static Vector3 Vector(FieldViewModel[] axes) =>
        new((float)axes[0].NumericValue, (float)axes[1].NumericValue, (float)axes[2].NumericValue);

    private static void Write(FieldViewModel[] axes, Vector3 value)
    {
        axes[0].NumericValue = value.X;
        axes[1].NumericValue = value.Y;
        axes[2].NumericValue = value.Z;
    }

    private static Vector3 QuaternionToEulerDeg(Quaternion q)
    {
        double sinXCosY = 2 * ((q.W * q.X) + (q.Y * q.Z));
        double cosXCosY = 1 - (2 * ((q.X * q.X) + (q.Y * q.Y)));
        double x = Math.Atan2(sinXCosY, cosXCosY);

        double sinY = 2 * ((q.W * q.Y) - (q.Z * q.X));
        double y = Math.Abs(sinY) >= 1 ? Math.CopySign(Math.PI / 2, sinY) : Math.Asin(sinY);

        double sinZCosY = 2 * ((q.W * q.Z) + (q.X * q.Y));
        double cosZCosY = 1 - (2 * ((q.Y * q.Y) + (q.Z * q.Z)));
        double z = Math.Atan2(sinZCosY, cosZCosY);

        const double radToDeg = 180.0 / Math.PI;
        return new Vector3((float)(x * radToDeg), (float)(y * radToDeg), (float)(z * radToDeg));
    }

    private static Quaternion EulerDegToQuaternion(Vector3 deg)
    {
        const double degToRad = Math.PI / 180.0;
        double hx = deg.X * degToRad * 0.5;
        double hy = deg.Y * degToRad * 0.5;
        double hz = deg.Z * degToRad * 0.5;

        double sx = Math.Sin(hx), cx = Math.Cos(hx);
        double sy = Math.Sin(hy), cy = Math.Cos(hy);
        double sz = Math.Sin(hz), cz = Math.Cos(hz);

        return new Quaternion(
            (float)((sx * cy * cz) - (cx * sy * sz)),
            (float)((cx * sy * cz) + (sx * cy * sz)),
            (float)((cx * cy * sz) - (sx * sy * cz)),
            (float)((cx * cy * cz) + (sx * sy * sz)));
    }
}
