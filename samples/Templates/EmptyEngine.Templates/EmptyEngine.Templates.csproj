<Project Sdk="Microsoft.NET.Sdk">

  <!-- ゲームサンプルを dotnet new テンプレートとして梱包する。 -->

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <Version>0.4.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <!-- テンプレートのソースディレクトリを指定する。 -->
  <PropertyGroup>
    <EmptyEngineTemplateContent>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../DotnetRuntimeSample'))</EmptyEngineTemplateContent>
  </PropertyGroup>

  <!-- 生成物を除いてテンプレートの内容を収集する。 -->
  <ItemGroup>
    <Content Include="$(EmptyEngineTemplateContent)/**"
             Exclude="$(EmptyEngineTemplateContent)/**/bin/**;$(EmptyEngineTemplateContent)/**/obj/**;$(EmptyEngineTemplateContent)/**/.artifacts/**;$(EmptyEngineTemplateContent)/**/.vs/**;$(EmptyEngineTemplateContent)/README.md"
             PackagePath="content/DotnetRuntimeSample/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
